---
/**
 * Demo-booking / contact form. Posts to the backend Supabase table `website_leads`
 * (insert-only for the anon role — see backend PR). Without PUBLIC_SUPABASE_* configured, it
 * degrades to a prefilled mailto: link, so the page never shows a dead form.
 */
import Pola from './Pola.astro';
import { SITE } from '../lib/site';

interface Props {
  kind: 'demo' | 'contact';
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;
const url = import.meta.env.PUBLIC_SUPABASE_URL || '';
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const isDemo = kind === 'demo';
---

<form
  class:list={['lead-form card relative p-6 sm:p-8', cls]}
  data-kind={kind}
  data-url={url}
  data-key={key}
  data-email={SITE.email}
  novalidate
>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-1.5 text-sm font-semibold">
      <span>Your name</span>
      <input name="name" required autocomplete="name" class="field" placeholder="Jane Wanjiru" />
    </label>
    <label class="grid gap-1.5 text-sm font-semibold">
      <span>{isDemo ? 'Your role' : 'Who are you?'}</span>
      <select name="role" required class="field">
        {isDemo ? (
          <>
            <option value="">Choose one</option>
            <option>Head teacher / Principal</option>
            <option>Deputy / Director of studies</option>
            <option>School director / owner</option>
            <option>Teacher</option>
            <option>ICT lead</option>
            <option>Other</option>
          </>
        ) : (
          <>
            <option value="">Choose one</option>
            <option>Parent or guardian</option>
            <option>Teacher</option>
            <option>School leader</option>
            <option>Partner / press</option>
            <option>Other</option>
          </>
        )}
      </select>
    </label>
    {isDemo && (
      <label class="grid gap-1.5 text-sm font-semibold sm:col-span-2">
        <span>School name</span>
        <input name="school" required autocomplete="organization" class="field" placeholder="e.g. Thorn Grove Schools" />
      </label>
    )}
    <label class="grid gap-1.5 text-sm font-semibold">
      <span>Email</span>
      <input name="email" type="email" required autocomplete="email" class="field" placeholder="you@school.ac.ke" />
    </label>
    <label class="grid gap-1.5 text-sm font-semibold">
      <span>Phone or WhatsApp</span>
      <input name="phone" type="tel" autocomplete="tel" class="field" placeholder="07xx xxx xxx" />
    </label>
    {isDemo && (
      <label class="grid gap-1.5 text-sm font-semibold">
        <span>County</span>
        <input name="county" class="field" placeholder="e.g. Nairobi" />
      </label>
    )}
    {isDemo && (
      <label class="grid gap-1.5 text-sm font-semibold">
        <span>Learners (approx.)</span>
        <select name="size" class="field">
          <option value="">Choose one</option>
          <option>Under 100</option>
          <option>100 – 300</option>
          <option>300 – 800</option>
          <option>800+</option>
        </select>
      </label>
    )}
    <label class="grid gap-1.5 text-sm font-semibold sm:col-span-2">
      <span>{isDemo ? 'What would you like to see?' : 'Message'}</span>
      <textarea name="message" rows="4" class="field" placeholder={isDemo ? 'Scheme of work, merit lists, timetabling, parent app…' : 'How can we help?'}></textarea>
    </label>
    {/* honeypot */}
    <input name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] opacity-0" aria-hidden="true" />
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="submit" class="btn-primary btn-lg">
      <span class="label">{isDemo ? 'Request a demo' : 'Send message'}</span>
      <svg class="spinner hidden animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9" stroke-linecap="round" /></svg>
    </button>
    <p class="text-sm text-muted-foreground">
      {isDemo ? 'We reply within one working day and set up a 30-minute walkthrough.' : 'Or WhatsApp us directly, any day of the week.'}
    </p>
  </div>
  <p class="status mt-4 hidden rounded-xl px-4 py-3 text-sm font-semibold" role="status" aria-live="polite"></p>

  <div class="done absolute inset-0 hidden flex-col items-center justify-center gap-4 rounded-2xl bg-card p-8 text-center">
    <Pola pose="love" size="9rem" seed={5} />
    <p class="font-display text-2xl font-bold">Thanks, we got it.</p>
    <p class="max-w-sm text-muted-foreground">{isDemo ? "We'll be in touch to find a time that suits your school." : "We'll get back to you shortly."}</p>
  </div>
</form>

<style>
  @reference "../styles/global.css";
  .field {
    @apply w-full rounded-xl border border-border bg-background px-4 py-3 text-base font-normal text-foreground outline-none transition-[border-color,box-shadow];
  }
  .field:focus { border-color: var(--primary); box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 18%, transparent); }
  .field:user-invalid { border-color: var(--destructive); }
  .lead-form.sending button[type='submit'] .spinner { display: inline-block; }
  .lead-form.sending button[type='submit'] { pointer-events: none; opacity: 0.8; }
  .lead-form.ok .done { display: flex; }
  .status.err { display: block; background: color-mix(in srgb, var(--destructive) 12%, transparent); color: var(--destructive); }
</style>

<script>
  function setup() {
    document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      const status = form.querySelector<HTMLElement>('.status')!;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'status mt-4 hidden rounded-xl px-4 py-3 text-sm font-semibold';
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        if (fd.get('website')) { form.classList.add('ok'); return; } // bot
        const payload = {
          kind: form.dataset.kind,
          name: String(fd.get('name') || '').trim(),
          role: String(fd.get('role') || ''),
          school: String(fd.get('school') || '').trim() || null,
          email: String(fd.get('email') || '').trim(),
          phone: String(fd.get('phone') || '').trim() || null,
          county: String(fd.get('county') || '').trim() || null,
          school_size: String(fd.get('size') || '') || null,
          message: String(fd.get('message') || '').trim() || null,
          source_path: location.pathname,
        };
        const url = form.dataset.url, key = form.dataset.key;
        if (!url || !key) {
          // Not configured: hand off to email with the details prefilled.
          const subject = encodeURIComponent(payload.kind === 'demo' ? `Demo request: ${payload.school || payload.name}` : `Website message from ${payload.name}`);
          const body = encodeURIComponent(Object.entries(payload).filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n'));
          location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
          return;
        }
        form.classList.add('sending');
        try {
          const r = await fetch(`${url}/rest/v1/website_leads`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: key, Authorization: `Bearer ${key}`, Prefer: 'return=minimal' },
            body: JSON.stringify(payload),
          });
          if (!r.ok) throw new Error(String(r.status));
          form.classList.add('ok');
          (window as any).plausible?.(payload.kind === 'demo' ? 'Demo request' : 'Contact message');
        } catch {
          status.textContent = "Something went wrong sending that. Please try again, or email us directly.";
          status.classList.add('err');
        } finally {
          form.classList.remove('sending');
        }
      });
    });
  }
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
