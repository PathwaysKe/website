---
/** Shared layout for long legal documents (Terms of Service, Privacy Policy). */
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  meta: { version: string; updated: string; effective: string; draft: boolean };
  intro: string;
  email: string;
  openPoints: string[];
  sections: { id: string; title: string; html: string }[];
}
const { title, description, meta, intro, email, openPoints, sections } = Astro.props;
---

<Base {title} {description} noindex={meta.draft}>
  <section class="container-x pb-20 pt-6 lg:pb-28">
    <header class="max-w-3xl">
      <p class="eyebrow mb-4">Legal</p>
      <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 text-sm text-muted-foreground">
        Version {meta.version} · Last updated {meta.updated} · Effective date: {meta.effective}
      </p>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {intro} Contact us at <a class="text-primary hover:underline" href={`mailto:${email}`}>{email}</a> with any questions.
      </p>
      {meta.draft && (
        <div class="draft mt-6 rounded-2xl border border-dashed p-5 text-sm">
          <strong>Draft, not yet in force.</strong> Open points before publication:
          <ul class="mt-2 list-disc pl-5">{openPoints.map((p) => <li>{p}</li>)}</ul>
        </div>
      )}
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[16rem_1fr]">
      <nav aria-label="Contents" class="toc lg:sticky lg:top-28 lg:self-start">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted-foreground">Contents</p>
        <ol class="mt-3 grid gap-1.5 text-sm">
          {sections.map((s, i) => (
            <li><a class="hover:text-primary" href={`#${s.id}`}><span class="tabular-nums text-muted-foreground">{i + 1}.</span> {s.title}</a></li>
          ))}
        </ol>
      </nav>

      <article class="legal max-w-3xl">
        {sections.map((s, i) => (
          <section id={s.id}>
            <h2><span>{i + 1}.</span> {s.title}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
      </article>
    </div>
  </section>
</Base>

<style>
  .draft { border-color: #d97706; background: #fef3c7; color: #78350f; }
  :global(.dark) .draft { background: color-mix(in srgb, #d97706 14%, transparent); color: #fcd34d; }
  .legal section { scroll-margin-top: 7rem; padding-top: 2rem; }
  .legal section + section { margin-top: 2rem; border-top: 1px solid var(--border); }
  .legal :global(h2) { font-family: var(--font-display, inherit); font-size: 1.5rem; font-weight: 700; line-height: 1.25; margin-bottom: 1rem; }
  .legal :global(h2 span) { color: var(--brand-teal-text); margin-right: 0.25rem; }
  .legal :global(p), .legal :global(li), .legal :global(td) { color: var(--muted-foreground); line-height: 1.75; }
  .legal :global(p + p), .legal :global(ul + p), .legal :global(ol + p), .legal :global(p + ul), .legal :global(p + ol), .legal :global(table + p), .legal :global(p + table) { margin-top: 0.9rem; }
  .legal :global(ul) { list-style: disc; padding-left: 1.4rem; display: grid; gap: 0.45rem; }
  .legal :global(ol) { list-style: lower-alpha; padding-left: 1.4rem; display: grid; gap: 0.45rem; }
  .legal :global(strong) { color: var(--foreground); font-weight: 650; }
  .legal :global(a) { color: var(--primary); }
  .legal :global(a:hover) { text-decoration: underline; }
  .legal :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .legal :global(th) { text-align: left; font-weight: 650; color: var(--foreground); padding: 0.6rem 0.75rem; border-bottom: 2px solid var(--border); }
  .legal :global(td) { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  @media print {
    .toc { display: none; }
    .legal :global(h2) { break-after: avoid; }
  }
</style>
