---
import Logo from './Logo.astro';
import Pola from './Pola.astro';
import { NAV, SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-border bg-background">
  <div class="container-x py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 font-display text-xl font-bold tracking-tight"><Logo size={36} /> Pathways</a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground">
          The all-in-one learning platform for Kenya's CBC. {SITE.tagline}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={SITE.playStoreUrl} target="_blank" rel="noopener" class="btn-ghost !py-2 text-xs">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M3.6 2.2 13.4 12 3.6 21.8c-.4-.2-.6-.6-.6-1.1V3.3c0-.5.2-.9.6-1.1z"/><path fill="#FBBC04" d="m16.8 15.4-3.4-3.4 3.4-3.4 4 2.3c1.1.6 1.1 1.6 0 2.2l-4 2.3z"/><path fill="#4285F4" d="M13.4 12 3.6 2.2c.3-.2.8-.2 1.3.1l11.9 6.3-3.4 3.4z"/><path fill="#EA4335" d="m13.4 12 3.4 3.4-11.9 6.3c-.5.3-1 .3-1.3.1l9.8-9.8z"/></svg>
            Get it on Google Play
          </a>
          <a href={SITE.portalUrl} target="_blank" rel="noopener" class="btn-ghost !py-2 text-xs">School portal</a>
        </div>
      </div>

      <nav aria-label="Site">
        <h3 class="font-sans text-xs font-bold tracking-[0.14em] text-muted-foreground uppercase">Explore</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          {NAV.map((n) => <li><a class="hover:text-primary" href={n.href}>{n.label}</a></li>)}
          <li><a class="hover:text-primary" href="/demo">Book a demo</a></li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h3 class="font-sans text-xs font-bold tracking-[0.14em] text-muted-foreground uppercase">Legal</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          <li><a class="hover:text-primary" href="/privacy">Privacy policy</a></li>
          <li><a class="hover:text-primary" href="/delete-data">Delete my data</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="font-sans text-xs font-bold tracking-[0.14em] text-muted-foreground uppercase">Talk to us</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          <li><a class="hover:text-primary" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>
            <a class="inline-flex items-center gap-1.5 hover:text-primary" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.6 11.4 11.4 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2 2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3z"/></svg>
              WhatsApp support
            </a>
          </li>
          <li class="text-muted-foreground">Nairobi, Kenya</li>
        </ul>
        <div class="mt-5 flex items-center gap-2">
          <button id="theme-toggle" class="btn-ghost !px-3 !py-1.5 text-xs" aria-pressed="false" title="Toggle dark mode">
            <span class="light-label">Dark mode</span><span class="dark-label">Light mode</span>
          </button>
          <button id="motion-toggle" class="btn-ghost !px-3 !py-1.5 text-xs" aria-pressed="false" title="Reduce animation">Reduce motion</button>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse items-start justify-between gap-6 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <p>© {year} Pathways. Learn together.</p>
      <div class="flex items-center gap-3">
        <Pola pose="sleepy" size="3.5rem" seed={11} />
        <p class="max-w-[22ch] leading-snug">Pola is resting. Come back any time.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .dark .light-label { display: none; }
  html:not(.dark) .dark-label { display: none; }
</style>

<script>
  function setup() {
    const t = document.getElementById('theme-toggle');
    const m = document.getElementById('motion-toggle');
    const html = document.documentElement;
    if (t && !t.dataset.bound) {
      t.dataset.bound = '1';
      t.setAttribute('aria-pressed', String(html.classList.contains('dark')));
      t.addEventListener('click', () => {
        const dark = !html.classList.contains('dark');
        html.classList.toggle('dark', dark);
        try { localStorage.setItem('pw-theme', dark ? 'dark' : 'light'); } catch {}
        t.setAttribute('aria-pressed', String(dark));
      });
    }
    if (m && !m.dataset.bound) {
      m.dataset.bound = '1';
      m.setAttribute('aria-pressed', String(html.classList.contains('reduce')));
      m.addEventListener('click', () => {
        const r = !html.classList.contains('reduce');
        html.classList.toggle('reduce', r);
        try { localStorage.setItem('pw-reduce', r ? '1' : '0'); } catch {}
        m.setAttribute('aria-pressed', String(r));
        location.reload();
      });
    }
  }
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
