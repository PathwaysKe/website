---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Pola from '../components/Pola.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../lib/site';

const description = 'Pathways is an all-in-one learning platform for Kenya\'s CBC: planning and reporting for schools, study material for families, an interactive hub for learners, and one shared picture of each child\'s progress.';

const values = [
  ['Say only what ships', 'Roadmap items are called roadmap items.'],
  ['Teachers plan, machines retype', 'Schemes start from the CBC design; teachers edit, not retype.'],
  ['Warm for a child, calm for an adult', 'The mascot never carries bad news. The attention colours do.'],
  ['Pay how Kenya pays', 'M-PESA for families, receipts for schools.'],
];
---

<Base title="About" {description}>
  <section class="container-x grid items-center gap-10 py-10 lg:grid-cols-[1.1fr_1fr] lg:py-16">
    <div>
      <p class="eyebrow mb-5" data-reveal>About Pathways</p>
      <h1 class="font-display text-4xl font-bold leading-[1.04] sm:text-5xl lg:text-6xl" data-reveal data-reveal-delay="0.05">
        We mapped the CBC once, so nobody has to <span class="marker">decode it twice<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 13 C 40 6, 90 4, 196 9" /></svg></span>.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground" data-reveal data-reveal-delay="0.1">
        The CBC is a good design that arrived without good tools. Parents lacked information and familiarity with the curriculum; teachers lacked resources and tools. Pathways is one platform for the parent, the learner and the school, with one shared picture of how each child is doing.
      </p>
    </div>
    <div class="relative mx-auto grid w-full max-w-md place-items-center" data-reveal="scale">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" aria-hidden="true">
        <circle class="ring-dashed" cx="50" cy="50" r="46" /><circle class="ring-solid" cx="50" cy="50" r="30" />
      </svg>
      <div class="relative grid place-items-center gap-4 p-10">
        <Logo size={120} />
        <Pola pose="hello" size="9rem" seed={2} label="Pola, the Pathways mascot" />
      </div>
    </div>
  </section>

  <section class="bg-background py-20 lg:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <SectionHeading eyebrow="The story" title="It started in a school hall, with questions nobody could answer." mark="nobody could answer" />
      <div class="prose-site grid gap-5 text-lg" data-reveal-stagger>
        <p>A school invited a speaker to explain the CBC to parents. The hall filled with questions, and most of them left unanswered. Among the parents were Caleb and Muriithi.</p>
        <p>The problem followed everyone home. What parents learned at school is not what their children are learning now, so it is hard to know what a child should be covering, let alone help with the homework.</p>
        <p>Caleb, a software engineer, and Muriithi, from publishing, put together a team to close that gap properly. The result is Pathways: one complete learning platform for the teacher, the parent and the learner, piloted with schools like {SITE.pilotSchools.join(', ')}.</p>
      </div>
    </div>
  </section>

  <section class="container-x py-20 lg:py-28">
    <SectionHeading eyebrow="How we work" title="Four rules we keep." mark="Four rules" align="center" />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2" data-reveal-stagger>
      {values.map(([t, d], i) => (
        <li class="card p-7">
          <span class="grid size-10 place-items-center rounded-full bg-teal-soft font-display font-bold text-teal-text">{i + 1}</span>
          <h3 class="mt-4 font-display text-xl font-bold">{t}</h3>
          <p class="mt-2 text-muted-foreground leading-relaxed">{d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-background py-20 lg:py-28">
    <div class="container-x">
      <div class="card flex flex-col items-center gap-8 p-8 sm:flex-row sm:p-10" data-reveal="scale">
        <Pola pose="talk" size="9rem" seed={21} label="Pola, the Pathways tutor" />
        <div>
          <p class="eyebrow">Meet Pola</p>
          <h2 class="mt-3 font-display text-3xl font-bold">The tutor your child will meet in the app.</h2>
          <p class="mt-3 text-muted-foreground">Pola is the compass come to life: the friendly guide who explains, gives hints and encourages your child through every note and test.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="card flex flex-col items-center gap-5 p-8 text-center sm:flex-row sm:text-left" data-reveal>
      <Pola pose="talk" size="6rem" seed={30} />
      <div class="flex-1">
        <h2 class="font-display text-2xl font-bold">Want to talk?</h2>
        <p class="mt-1 text-muted-foreground">Schools, families, partners, press. We read everything.</p>
      </div>
      <a href="/contact" class="btn-primary btn-lg">Contact us</a>
    </div>
  </section>
</Base>
