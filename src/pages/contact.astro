---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Pola from '../components/Pola.astro';
import { SITE } from '../lib/site';

const description = 'Talk to the Pathways team: email hello@pathways.ke, WhatsApp technical support, or send a message. Schools can book a demo; parents can ask about the app.';
---

<Base title="Contact" {description}>
  <section class="container-x grid gap-12 py-10 lg:grid-cols-[1fr_1.3fr] lg:py-16">
    <div>
      <p class="eyebrow mb-5" data-reveal>Contact</p>
      <h1 class="font-display text-4xl font-bold leading-[1.04] sm:text-5xl" data-reveal data-reveal-delay="0.05">Say hello. We answer.</h1>
      <p class="mt-5 text-lg text-muted-foreground" data-reveal data-reveal-delay="0.1">A small team in Nairobi reads every message. Schools usually hear back the same working day.</p>

      <ul class="mt-8 grid gap-4" data-reveal-stagger>
        <li class="card flex items-center gap-4 p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-primary-container text-primary-container-foreground">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>
          </span>
          <div><b class="font-semibold">Email</b><br /><a class="text-primary hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
        </li>
        <li class="card flex items-center gap-4 p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-[#dcfce7] text-[#15803d]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.6 11.4 11.4 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2 2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3z"/></svg>
          </span>
          <div><b class="font-semibold">WhatsApp support</b><br /><a class="text-primary hover:underline" href={`https://wa.me/${SITE.whatsapp.e164}`} target="_blank" rel="noopener">{SITE.whatsapp.display}</a> <span class="text-sm text-muted-foreground">· technical help, school hours</span></div>
        </li>
        <li class="card flex items-center gap-4 p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-teal-soft text-teal-text">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-5 9 5-9 5z"/><path d="M7 12.5V17c0 1 2.5 2 5 2s5-1 5-2v-4.5"/></svg>
          </span>
          <div><b class="font-semibold">Running a school?</b><br /><a class="text-primary hover:underline" href="/demo">Book a demo instead</a> <span class="text-sm text-muted-foreground">· 30 minutes, your timetable</span></div>
        </li>
      </ul>
      <div class="mt-10 hidden lg:block" data-reveal="scale"><Pola pose="talk" size="8rem" seed={40} /></div>
    </div>
    <div data-reveal="right"><LeadForm kind="contact" /></div>
  </section>
</Base>
