---
import Base from '../layouts/Base.astro';
import Pola from '../components/Pola.astro';
---

<Base title="Page not found" description="That page isn't on the map." noindex>
  <section class="container-x grid min-h-[60vh] place-items-center py-16 text-center">
    <div class="max-w-md">
      <Pola pose="oops" size="10rem" seed={60} label="Pola looking apologetic" />
      <p class="eyebrow mt-6 justify-center">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold">That page isn't on the map.</h1>
      <p class="mt-3 text-muted-foreground">The link may be old, or the page moved. The two most useful places are below.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/schools" class="btn-teal">For Schools</a>
        <a href="/parents" class="btn-primary">For Parents</a>
        <a href="/" class="btn-ghost">Home</a>
      </div>
    </div>
  </section>
</Base>
