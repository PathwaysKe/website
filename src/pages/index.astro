---
import Base from '../layouts/Base.astro';
import OrbitHub from '../components/OrbitHub.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Pola from '../components/Pola.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SubjectMarquee from '../components/SubjectMarquee.astro';
import PortalMock from '../components/PortalMock.astro';
import { SITE } from '../lib/site';

const description =
  'Pathways is the all-in-one learning platform for Kenya\'s CBC: planning and reporting for schools, study material for learners, progress for parents and teachers.';

// The hero cycles through who it is built for; each audience lights up its own features.
const audiences = [
  { who: 'teacher', color: 'var(--brand-teal)', features: ['Schemes of work', 'Lesson plans', 'Merit lists', 'Coverage'] },
  { who: 'learner', color: 'var(--gold-deep)', features: ['Study notes', 'Study cards', 'Tests and exam prep', 'AI tutor'] },
  { who: 'parent', color: 'var(--primary)', features: ['Progress per child', 'Results', 'Announcements', 'One account'] },
];
---

<Base title={SITE.name} {description}>
  {/* ---------------- HERO ---------------- */}
  <section class="hero relative overflow-hidden">
    <div class="container-x grid items-center gap-10 py-10 lg:grid-cols-[1.05fr_1fr] lg:py-16">
      <div class="relative z-10">
        <p class="eyebrow mb-5" data-hero>Kenya's CBC, all in one place</p>
        <h1 id="hero-title" class="font-display text-[2.8rem] leading-[1.02] font-bold sm:text-6xl lg:text-[4.6rem]">
          Built for the<br />
          <span class="swap relative inline-block align-top" aria-live="polite">
            {audiences.map((a, i) => (
              <span class:list={['swap-word', i === 0 && 'is-on']} style={`color:${a.color}`} data-i={i} aria-hidden={i !== 0 ? 'true' : undefined}>{a.who}.</span>
            ))}
          </span>
        </h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground sm:text-xl" data-hero>
          One platform that plans the teaching, powers the studying, and shows everyone how the child is doing.
        </p>

        <div class="mt-7 flex flex-wrap gap-3" data-hero>
          <a href="/schools" class="btn-teal btn-lg">For Schools</a>
          <a href="/parents" class="btn-primary btn-lg">For Families</a>
        </div>

        {/* Feature strip: the group for the current audience is highlighted. */}
        <div class="feature-strip mt-9" data-hero aria-label="What's inside">
          {audiences.map((a, i) => (
            <ul class:list={['strip', i === 0 && 'is-on']} data-i={i} style={`--c:${a.color}`}>
              {a.features.map((f) => <li><i></i>{f}</li>)}
            </ul>
          ))}
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[560px]" id="hero-art">
        <OrbitHub class="hero-orbit" angles={[-54, -26, 26, 54, 126, 154, 206, 234]}>
          <PhoneFrame video="hub-loop" alt="The Pathways app home screen: a child's subjects orbiting their avatar" class="hero-phone w-[140px] sm:w-[170px] lg:w-[180px]" loading="eager" />
        </OrbitHub>
        <div class="hero-pola absolute -right-3 -bottom-2 sm:-right-8 sm:-bottom-4" data-pola-float>
          <Pola pose="hello" size="clamp(5.5rem, 14vw, 8.5rem)" loading="eager" seed={2} label="Pola, the Pathways mascot, waving hello" />
        </div>
      </div>
    </div>
    <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  </section>

  <SubjectMarquee class="mt-2" />

  {/* ---------------- THREE SIDES ---------------- */}
  <section class="container-x py-20 lg:py-28">
    <SectionHeading eyebrow="Three sides, one record" title="The school, the learner and the parent, on one page." mark="one page" align="center" />
    <div class="mt-12 grid gap-6 lg:grid-cols-3" data-reveal-stagger="0.1">
      <article class="side card flex flex-col overflow-hidden p-7" style="--c: var(--brand-teal)">
        <p class="eyebrow">The school</p>
        <h3 class="mt-2 font-display text-2xl font-bold">Teaching, with the paperwork done.</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          {['Schemes and lesson plans from the CBC design', 'Merit lists with EE / ME / AE / BE bands', 'Coverage rolled up for the head teacher'].map((t) => <li class="flex gap-2.5"><i class="mt-1.5 size-2 shrink-0 rounded-full" style="background: var(--c)"></i>{t}</li>)}
        </ul>
        <a href="/schools" class="mt-5 mb-7 inline-flex items-center gap-1.5 font-semibold text-teal-text">Explore the portal <span aria-hidden="true">→</span></a>
        <div class="well"><div class="absolute top-6 left-6 w-[125%]"><PortalMock view="merit" compact /></div></div>
      </article>

      <article class="side card flex flex-col overflow-hidden p-7" style="--c: var(--gold-deep)">
        <p class="eyebrow" style="color: var(--gold-deep)">The learner</p>
        <h3 class="mt-2 font-display text-2xl font-bold">Studying that feels like play.</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          {['Notes with worked examples, study cards for revision', 'Practice tests, quizzes and exam prep', 'Pola, the AI tutor, one child at a time'].map((t) => <li class="flex gap-2.5"><i class="mt-1.5 size-2 shrink-0 rounded-full" style="background: var(--c)"></i>{t}</li>)}
        </ul>
        <a href="/parents#walkthrough" class="mt-5 mb-7 inline-flex items-center gap-1.5 font-semibold" style="color: var(--gold-deep)">See a study session <span aria-hidden="true">→</span></a>
        <div class="well"><div class="absolute top-6 left-1/2 w-[180px] -translate-x-1/2"><PhoneFrame video="walk-finish" alt="Finishing a study note in Pathways: Great job, with confetti" /></div></div>
      </article>

      <article class="side card flex flex-col overflow-hidden p-7" style="--c: var(--primary)">
        <p class="eyebrow" style="color: var(--primary)">The parent</p>
        <h3 class="mt-2 font-display text-2xl font-bold">Progress you can actually see.</h3>
        <ul class="mt-4 grid gap-2 text-sm">
          {['Strengths and gaps per child, shared with the teacher', 'Results, calendar and announcements from the school', 'One household account, M-PESA billing'].map((t) => <li class="flex gap-2.5"><i class="mt-1.5 size-2 shrink-0 rounded-full" style="background: var(--c)"></i>{t}</li>)}
        </ul>
        <a href="/parents" class="mt-5 mb-7 inline-flex items-center gap-1.5 font-semibold text-primary">For families <span aria-hidden="true">→</span></a>
        <div class="well"><div class="absolute top-6 left-1/2 w-[180px] -translate-x-1/2"><PhoneFrame screen="results-jesma" alt="A learner's published results with class mean and bands" /></div></div>
      </article>
    </div>
  </section>

  {/* ---------------- CHALKBOARD ---------------- */}
  <section class="bg-background py-20 lg:py-28">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Why it works" title="A lesson is only finished when a child can do it alone." mark="do it alone" lead="Explain, show, check. Every check feeds the progress the parent and teacher share." />
        <ul class="mt-8 grid gap-3" data-reveal-stagger>
          {[['Explain', 'Plain-language notes with key words.'], ['Show', 'Worked examples, one step at a time.'], ['Check', 'Short questions, gentle feedback.'], ['Report', 'Progress per child; merit lists per class.']].map(([t, d], i) => (
            <li class="flex items-center gap-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary-container font-display font-bold text-primary-container-foreground">{i + 1}</span>
              <p><b class="font-semibold">{t}</b> <span class="text-muted-foreground">· {d}</span></p>
            </li>
          ))}
        </ul>
      </div>
      <div class="chalk relative" data-reveal="scale">
        <div class="chalkboard relative overflow-hidden rounded-3xl p-7 text-white sm:p-10">
          <p class="text-xs font-bold tracking-[0.14em] text-white/60 uppercase">Grade 5 · Measurement</p>
          <p class="mt-2 font-display text-2xl font-bold">Area of a triangle</p>
          <svg class="mt-5 w-full" viewBox="0 0 320 170" aria-hidden="true">
            <path id="tri" d="M30 150 L160 20 L290 150 Z" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round" />
            <path id="tri-h" d="M160 20 V150" fill="none" stroke="var(--gold)" stroke-width="3" stroke-dasharray="6 7" stroke-linecap="round" />
            <path id="tri-b" d="M30 158 H290" fill="none" stroke="var(--gold)" stroke-width="3" stroke-linecap="round" />
            <text id="tri-lb" x="160" y="168" text-anchor="middle" fill="var(--gold)" font-size="14" font-weight="700" opacity="0">b = 8 cm</text>
            <text id="tri-lh" x="172" y="90" fill="var(--gold)" font-size="14" font-weight="700" opacity="0">h = 5 cm</text>
          </svg>
          <p class="formula mt-5 font-display text-3xl font-semibold tracking-wide sm:text-4xl" aria-label="Area equals a half times b times h equals a half times 8 times 5 equals 20 square centimetres">
            <span class="f1">A = ½ × b × h</span><br />
            <span class="f2 text-white/80">= ½ × 8 × 5</span><br />
            <span class="f3 text-[var(--gold)]">= 20 cm²</span>
          </p>
          <span class="tick absolute right-6 bottom-6 grid size-11 place-items-center rounded-full bg-[var(--gold)] text-[#1c1300]" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
          </span>
        </div>
        <div class="absolute -top-8 -left-4 sm:-left-8" data-pola-float><Pola pose="read" size="5.5rem" seed={9} /></div>
      </div>
    </div>
  </section>

  {/* ---------------- THE MAP ---------------- */}
  <section class="container-x py-20 lg:py-28">
    <SectionHeading eyebrow="One map underneath" title="What a child meets in class is what they meet at home." mark="at home" align="center" lead="Teachers plan on the CBC map. Learners study on it. Parents follow it." />
    <div class="map-flow relative mx-auto mt-14 max-w-5xl" data-reveal>
      <svg class="absolute inset-x-0 top-9 hidden h-2 w-full lg:block" viewBox="0 0 1000 8" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 4 H980" fill="none" stroke="var(--border)" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round" />
        <path id="map-draw" d="M20 4 H980" fill="none" stroke="var(--brand-teal)" stroke-width="3" stroke-linecap="round" />
      </svg>
      <ol class="grid gap-6 lg:grid-cols-5" data-reveal-stagger="0.12">
        {[['Learning area', 'Mathematics', 'var(--subj-math)'], ['Strand', 'Numbers', 'var(--subj-eng)'], ['Sub-strand', 'Addition', 'var(--subj-swa)'], ['Lesson', 'Adding with regrouping', 'var(--subj-sci)'], ['Note + test', 'Worked example, 5 questions', 'var(--subj-soc)']].map(([k, v, c], i) => (
          <li class="relative text-center">
            <span class="relative z-10 mx-auto grid size-[4.6rem] place-items-center rounded-full border-2 bg-card font-display text-xl font-bold" style={`border-color:${c};color:${c}`}>{i + 1}</span>
            <p class="mt-4 text-xs font-bold tracking-[0.12em] text-muted-foreground uppercase">{k}</p>
            <p class="mt-1 font-semibold">{v}</p>
          </li>
        ))}
      </ol>
      <div class="pointer-events-none absolute -top-24 right-[17%] hidden lg:block" data-pola-float><Pola pose="tip" size="5.5rem" seed={4} /></div>
    </div>
  </section>

  {/* ---------------- TRUST ---------------- */}
  <section class="bg-background py-16">
    <div class="container-x grid gap-6 md:grid-cols-3" data-reveal-stagger>
      {[
        ['Grades 1 to 9', 'The whole of basic education, mapped.'],
        ['M-PESA', 'Families pay by phone. Schools get receipts.'],
        [SITE.pilotSchools[0], 'Teachers and parents onboarded. Yours next?'],
      ].map(([h, d]) => (
        <div class="card p-6"><p class="font-display text-3xl font-bold">{h}</p><p class="mt-2 text-sm text-muted-foreground">{d}</p></div>
      ))}
    </div>
  </section>

  {/* ---------------- CTA ---------------- */}
  <section class="container-x py-20 lg:py-28">
    <div class="cta relative overflow-hidden rounded-3xl bg-[var(--brand-teal)] px-7 py-14 text-center text-white sm:px-12 sm:py-20" data-celebrate>
      <div class="confetti-field pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-2xl flex-col items-center">
        <Pola pose="cheer" size="8rem" seed={7} />
        <h2 class="mt-4 font-display text-3xl font-bold sm:text-5xl">Let's put your school and your home on one page.</h2>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/demo" class="btn bg-white text-[var(--brand-teal-deep)] hover:-translate-y-0.5">Book a school demo</a>
          <a href={SITE.playStoreUrl} target="_blank" rel="noopener" class="btn border border-white/40 bg-white/10 text-white hover:bg-white/20">Get the app</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  @reference "../styles/global.css";
  .hero-glow {
    background:
      radial-gradient(60% 50% at 75% 45%, color-mix(in srgb, var(--primary) calc(var(--halo) * 45%), transparent), transparent 70%),
      radial-gradient(40% 40% at 15% 10%, color-mix(in srgb, var(--brand-teal) calc(var(--halo) * 40%), transparent), transparent 70%);
  }
  /* cycling word */
  .swap { min-width: 5.2ch; height: 1.02em; }
  .swap-word { position: absolute; left: 0; top: 0; white-space: nowrap; opacity: 0; transform: translateY(0.35em) rotate(2deg); transform-origin: left bottom; transition: opacity .45s var(--ease-out-expo), transform .55s var(--ease-out-expo); }
  .swap-word.is-on { opacity: 1; transform: none; }
  .swap-word.is-off { opacity: 0; transform: translateY(-0.35em) rotate(-2deg); }
  /* feature strip */
  .feature-strip { position: relative; min-height: 2.6rem; }
  .strip { position: absolute; inset: 0; display: flex; flex-wrap: wrap; gap: .5rem; opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s var(--ease-out-expo); pointer-events: none; }
  .strip.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .strip li { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .8rem; border-radius: 999px; font-size: .8rem; font-weight: 600; border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border)); background: color-mix(in srgb, var(--c) 8%, var(--card)); color: var(--foreground); }
  .strip li i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--c); }
  html.reduce .swap-word, html.reduce .strip { transition: none; }

  .hero-phone { filter: drop-shadow(0 30px 40px rgb(15 23 42 / .25)); }
  .side { transition: transform .35s var(--ease-out-expo), box-shadow .35s; }
  .side .well { position: relative; margin: auto -1.75rem -1.75rem; padding-top: 1.75rem; height: 17rem; overflow: hidden; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--c) 9%, var(--card))); border-top: 1px solid color-mix(in srgb, var(--c) 12%, var(--border)); }
  .side .well > div { filter: drop-shadow(0 18px 30px rgb(15 23 42 / .18)); }
  .side:hover { transform: translateY(-4px); box-shadow: var(--shadow-float); }
  .chalkboard { background: radial-gradient(120% 100% at 20% 0%, #164e4a, #0f3b39 60%, #0b2b2a); box-shadow: var(--shadow-float), inset 0 0 0 1px rgb(255 255 255 / .06); }
  .chalkboard .tick { opacity: 0; transform: scale(.5); }
  .chalkboard .f2, .chalkboard .f3 { opacity: 0; }
  html.reduce .chalkboard .tick, html.reduce .chalkboard .f2, html.reduce .chalkboard .f3, html.reduce #tri-lb, html.reduce #tri-lh { opacity: 1 !important; transform: none; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced, splitWords, onPage } from '../lib/motion';

  onPage(() => {
    const title = document.getElementById('hero-title');
    if (!title) return;
    const R = reduced();

    // ---- Cycling audience word + synced feature strip ----
    const words = Array.from(document.querySelectorAll<HTMLElement>('.swap-word'));
    const strips = Array.from(document.querySelectorAll<HTMLElement>('.strip'));
    let cur = 0, timer = 0;
    const show = (i: number) => {
      words.forEach((w, k) => { w.classList.toggle('is-on', k === i); w.classList.toggle('is-off', k === cur && k !== i); w.toggleAttribute('aria-hidden', k !== i); });
      strips.forEach((s, k) => s.classList.toggle('is-on', k === i));
      cur = i;
    };
    // Under reduced motion the word still changes, just instantly and less often.
    timer = window.setInterval(() => show((cur + 1) % words.length), R ? 5000 : 3200);
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true });

    // ---- Hero entrance ----
    const staticWords = splitWords(title).filter((w) => !w.closest('.swap'));
    const planets = gsap.utils.toArray<HTMLElement>('#hero-art [data-planet]');
    const heroBits = gsap.utils.toArray<HTMLElement>('[data-hero]');
    const phone = document.querySelector('#hero-art .hero-phone');
    const pola = document.querySelector('#hero-art .hero-pola');
    const swap = document.querySelector('.swap');
    if (R) {
      gsap.set([staticWords, heroBits, planets, phone, pola, swap], { opacity: 1 });
    } else {
      const start = () => {
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.fromTo(staticWords, { yPercent: 110, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.9, stagger: 0.06 }, 0)
          .fromTo(swap, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8 }, 0.25)
          .fromTo(heroBits, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1 }, 0.35)
          .fromTo(phone, { scale: 0.7, opacity: 0, y: 30 }, { scale: 1, opacity: 1, y: 0, duration: 1, ease: 'back.out(1.4)' }, 0.2)
          .fromTo(planets, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.7, ease: 'back.out(2)', stagger: 0.07 }, 0.45)
          .fromTo(pola, { scale: 0.6, opacity: 0, rotate: -12 }, { scale: 1, opacity: 1, rotate: 0, duration: 0.8, ease: 'elastic.out(1, 0.55)' }, 0.9);
      };
      gsap.set(staticWords, { yPercent: 110, opacity: 0 });
      gsap.set([heroBits, phone, planets, pola, swap], { opacity: 0 });
      if (document.documentElement.classList.contains('intro')) document.addEventListener('pw:intro-done', start, { once: true });
      else start();

      const art = document.getElementById('hero-art')!;
      if (matchMedia('(pointer: fine)').matches) {
        const qx = gsap.quickTo(planets, 'x', { duration: 0.6, ease: 'power3' });
        const qy = gsap.quickTo(planets, 'y', { duration: 0.6, ease: 'power3' });
        art.addEventListener('pointermove', (e) => {
          const r = art.getBoundingClientRect();
          qx(((e.clientX - r.left) / r.width - 0.5) * 14); qy(((e.clientY - r.top) / r.height - 0.5) * 14);
        });
        art.addEventListener('pointerleave', () => { qx(0); qy(0); });
      }
    }

    // ---- Map line ----
    const draw = document.getElementById('map-draw');
    if (draw && !R) gsap.fromTo(draw, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.6, ease: 'power2.inOut', scrollTrigger: { trigger: '.map-flow', start: 'top 75%', once: true } });

    // ---- Chalkboard ----
    const chalk = document.querySelector('.chalkboard');
    if (chalk && !R) {
      const tl = gsap.timeline({ scrollTrigger: { trigger: chalk, start: 'top 70%', once: true }, defaults: { ease: 'power2.inOut' } });
      tl.fromTo('#tri', { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.1 })
        .fromTo('#tri-b', { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.5 })
        .to('#tri-lb', { opacity: 1, duration: 0.3 }, '<0.2')
        .fromTo('#tri-h', { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.5 })
        .to('#tri-lh', { opacity: 1, duration: 0.3 }, '<0.2')
        .fromTo('.chalkboard .f2', { opacity: 0, x: -10 }, { opacity: 1, x: 0, duration: 0.5 }, '+=0.2')
        .fromTo('.chalkboard .f3', { opacity: 0, x: -10 }, { opacity: 1, x: 0, duration: 0.5 }, '+=0.25')
        .to('.chalkboard .tick', { opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(2.5)' }, '+=0.1');
    }

    // ---- Floating Polas ----
    if (!R) gsap.utils.toArray<HTMLElement>('[data-pola-float]').forEach((el) => gsap.to(el, { y: -24, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.8 } }));

    // ---- CTA confetti ----
    const cta = document.querySelector<HTMLElement>('[data-celebrate]');
    if (cta && !R) {
      const field = cta.querySelector('.confetti-field')!;
      const cols = ['#fcd34d', '#ffffff', '#71dad7', '#a78bfa', '#fb923c', '#34d399'];
      ScrollTrigger.create({
        trigger: cta, start: 'top 70%', once: true,
        onEnter: () => {
          for (let i = 0; i < 42; i++) {
            const b = document.createElement('i');
            b.className = 'confetti'; b.style.background = cols[i % cols.length]; b.style.left = '50%'; b.style.top = '45%';
            field.appendChild(b);
            const a = Math.random() * Math.PI * 2, d = 140 + Math.random() * 260;
            gsap.fromTo(b, { opacity: 1, x: 0, y: 0, rotate: 0 }, { x: Math.cos(a) * d, y: Math.sin(a) * d * 0.7 + 120, rotate: Math.random() * 720, opacity: 0, duration: 1.4 + Math.random() * 0.6, ease: 'power2.out', delay: Math.random() * 0.15, onComplete: () => b.remove() });
          }
        },
      });
    }
  });
</script>
