---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortalMock from '../components/PortalMock.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Pola from '../components/Pola.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../lib/site';

const description =
  'Pathways for Schools: schemes of work, lesson plans, merit lists and coverage from the CBC design, with every teacher connected to their learners\' parents. Book a demo.';

const features = [
  { t: 'Scheme of Work', d: 'Generated per subject, grade and term. Edit any week.', icon: 'layers', c: 'var(--subj-math)' },
  { t: 'Lesson Plans', d: 'Pre-filled from the scheme. Teachers refine, not retype.', icon: 'book', c: 'var(--subj-eng)' },
  { t: 'Formative hub', d: 'Checks, homework and subject tests, marked in one place.', icon: 'check', c: 'var(--subj-swa)' },
  { t: 'Merit lists', d: 'Marks grid, EE / ME / AE / BE bands, published to parents.', icon: 'award', c: 'var(--subj-sci)' },
  { t: 'Record of Work', d: 'Tick what was taught; coverage rolls up to the head.', icon: 'chart', c: 'var(--subj-soc)' },
  { t: 'Timetable and calendar', d: 'One school timetable, per-teacher views, announcements.', icon: 'calendar', c: 'var(--subj-art)' },
  { t: 'Learners and insights', d: 'Roster, setup wizard, progress per learner.', icon: 'users', c: 'var(--subj-cre)' },
  { t: 'Curriculum library', d: 'Study notes for every sub-strand, shared with homes.', icon: 'file', c: 'var(--subj-agri)' },
];
const ICONS: Record<string, string> = {
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  book: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5z"/>',
  check: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="M8.5 14l-1.5 7 5-3 5 3-1.5-7"/>',
  chart: '<path d="M4 20V4M4 20h16M8 16v-4M12 16V8M16 16v-6"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.5 0 4.5 1.5 4.5 4.5"/>',
  file: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
};

const week = [
  ['Monday', 'Plan', 'This week in the scheme: "Adding with regrouping", 5 lessons, plans already drafted.', 'scheme'],
  ['Tuesday', 'Teach', 'Teach, tick it in the Record of Work, set a 5-question check as homework.', 'coverage'],
  ['Thursday', 'Check', 'Attempts come back marked. Two children need the worked example; assign it in a tap.', 'coverage'],
  ['End of term', 'Report', 'Marks into the grid, bands reviewed, results published to parents.', 'merit'],
];

const faqs = [
  { q: 'Does it follow the official CBC design?', a: 'Yes. Outcomes for Grades 1 to 9 are mapped by learning area, strand and sub-strand; schemes are generated from that map and teachers edit any week.' },
  { q: 'How are schools billed?', a: 'Per learner, per term, for each grade you sponsor. A sponsorship also covers those families in the app. We quote after a short call.' },
  { q: 'What do teachers need?', a: 'A browser, on a laptop or a phone. Most staff rooms are set up in an afternoon.' },
  { q: 'Can parents see results?', a: 'Yes. Publish a merit list and linked families see results, class mean and bands in the app, with your calendar and announcements.' },
  { q: 'Is our data safe?', a: 'Each school\'s data is isolated by row-level security, access is role-based, and we never sell learner data. See the <a class="underline" href="/privacy">privacy policy</a>.' },
  { q: 'What is not in the portal yet?', a: 'Attendance and a question bank marketplace are roadmap, not product. We show what ships.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pathways for Schools',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  url: `${SITE.url}/schools`,
  offers: { '@type': 'Offer', priceCurrency: 'KES', description: 'Per learner, per term. Quoted per school.' },
};
---

<Base title="For Schools" {description} image="/og/schools.png" {jsonLd}>
  <section class="container-x grid items-center gap-10 py-10 lg:grid-cols-[1fr_1.1fr] lg:py-16">
    <div>
      <p class="eyebrow mb-5" data-reveal>Pathways for Schools</p>
      <h1 class="font-display text-4xl font-bold leading-[1.06] sm:text-5xl lg:text-[3.4rem]" data-reveal data-reveal-delay="0.05">
        Planning, teaching and merit lists your teachers <span class="marker">keep updated.<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 13 C 40 6, 90 4, 196 9" /></svg></span>
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground" data-reveal data-reveal-delay="0.1">
        The paperwork of teaching, automated from the CBC design. Every teacher connected to their learners' parents. Coverage the head can see.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.15">
        <a href="/demo" class="btn-teal btn-lg">Book a 30-minute demo</a>
        <a href={SITE.portalUrl + '/login'} class="btn-ghost btn-lg" rel="noopener">Teacher login</a>
      </div>
      <p class="mt-5 text-sm text-muted-foreground" data-reveal data-reveal-delay="0.2">Trusted by {SITE.pilotSchools.join(', ')}. Works on any laptop or phone browser.</p>
    </div>
    <div class="relative pb-16 sm:pb-20" data-reveal="scale">
      <PortalMock view="scheme" />
      <div class="absolute right-0 bottom-4 w-[46%] sm:-right-4" data-reveal="up" data-reveal-delay="0.3"><PortalMock view="coverage" compact /></div>
      <div class="absolute -top-10 -left-2 sm:-left-6" data-pola-float><Pola pose="tip" size="5.5rem" seed={3} /></div>
      <p class="absolute bottom-0 left-0 text-xs text-muted-foreground">Illustrative views of the portal's scheme of work and coverage screens.</p>
    </div>
  </section>

  <section class="bg-background py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="What ships today" title="Everything a staff room needs, nothing it doesn't." mark="staff room" />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger="0.07">
        {features.map((f) => (
          <li class="card feature group p-6">
            <span class="grid size-11 place-items-center rounded-xl" style={`color:${f.c};background:color-mix(in srgb, ${f.c} 14%, transparent)`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[f.icon]} />
            </span>
            <h3 class="mt-4 font-display text-lg font-bold">{f.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-x py-20 lg:py-28">
    <SectionHeading eyebrow="A week in Pathways" title="Monday's plan to end-of-term report, nothing re-typed." mark="nothing re-typed" align="center" />
    <div class="week relative mx-auto mt-14 max-w-5xl">
      <div class="absolute top-0 bottom-0 left-[1.35rem] w-px bg-border lg:left-1/2" aria-hidden="true"></div>
      <ol class="grid gap-10">
        {week.map(([day, verb, text, view], i) => (
          <li class:list={['relative grid items-center gap-6 pl-14 lg:grid-cols-2 lg:pl-0', i % 2 ? 'lg:[&>div:first-child]:order-2' : '']} data-reveal>
            <div class:list={['lg:px-12', i % 2 ? 'lg:text-left' : 'lg:text-right']}>
              <span class="absolute top-1 left-0 grid size-11 place-items-center rounded-full border-2 border-[var(--brand-teal)] bg-card font-display font-bold text-teal-text lg:left-1/2 lg:-translate-x-1/2">{i + 1}</span>
              <p class="eyebrow">{day}</p>
              <h3 class="mt-2 font-display text-2xl font-bold">{verb}</h3>
              <p class="mt-2 text-muted-foreground leading-relaxed">{text}</p>
            </div>
            <div class="lg:px-12"><PortalMock view={view as 'merit' | 'scheme' | 'coverage'} class="origin-top scale-[.96]" /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-background py-20 lg:py-28">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <SectionHeading eyebrow="Teacher to parent to learner" title="Publish once. Every linked family sees it." mark="Every linked family" lead="Sponsor a grade and its families get the full app: results, calendar, announcements, and the notes that match this week's lessons." />
        <ul class="mt-8 grid gap-3 text-sm" data-reveal-stagger>
          {['Results with class mean and bands', 'Calendar and timetable on every parent\'s phone', 'Announcements that don\'t get lost in WhatsApp', 'Progress per learner, seen by teacher and parent'].map((t) => (
            <li class="flex items-start gap-2.5"><i class="mt-1.5 size-2 shrink-0 rounded-full bg-[var(--brand-teal)]"></i>{t}</li>
          ))}
        </ul>
        <a href="/parents" class="btn-ghost mt-8">See the parent app</a>
      </div>
      <div class="flex justify-center gap-5" data-reveal="scale">
        <PhoneFrame screen="results-jesma" alt="A learner's published results: mean 61.1, class mean 65.5, Meeting Expectations" class="w-[170px] -rotate-3 sm:w-[210px]" />
        <PhoneFrame screen="hub-collins" alt="A parent's home screen with a child linked to Victory House school" class="w-[170px] translate-y-8 rotate-3 sm:w-[210px]" />
      </div>
    </div>
  </section>

  <section class="container-x py-20 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <SectionHeading eyebrow="Pricing" title="Per learner, per term. Quoted for your school." mark="Quoted for your school" lead="Sponsor the grades you want covered. The rate depends on your size, so we price it on a short call." />
      <div class="card p-7 sm:p-9" data-reveal="right">
        <ul class="grid gap-4">
          {[
            ['Whole-school portal', 'Every admin and teacher, unlimited classes.'],
            ['Parent app for sponsored grades', 'Every family in the grade, linked to your school.'],
            ['Onboarding', 'Roster import and a staff-room walkthrough in week one.'],
            ['M-PESA and invoicing', 'Receivables and receipts per term.'],
            ['WhatsApp support', 'A real person, school hours.'],
          ].map(([t, d]) => (
            <li class="flex gap-3"><svg class="mt-1 shrink-0 text-teal-text" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><div><b class="font-semibold">{t}</b><p class="text-sm text-muted-foreground">{d}</p></div></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/demo" class="btn-teal btn-lg">Get a quote and a demo</a>
          <p class="text-sm text-muted-foreground">Individual teachers start free; Teacher Pro is KES 500 a month.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-20 lg:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <SectionHeading eyebrow="Questions" title="What school leaders ask us first." mark="ask us first" />
        <div class="mt-8 hidden lg:block" data-reveal="scale"><Pola pose="think" size="9rem" seed={6} /></div>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="container-x py-16">
    <div class="card flex flex-col items-center gap-5 p-8 text-center sm:flex-row sm:text-left" data-reveal>
      <Pola pose="hello" size="6rem" seed={8} />
      <div class="flex-1">
        <h2 class="font-display text-2xl font-bold">See it with your own timetable.</h2>
        <p class="mt-1 text-muted-foreground">Bring one grade. We set it up live on the call.</p>
      </div>
      <a href="/demo" class="btn-teal btn-lg">Book a demo</a>
    </div>
  </section>
</Base>

<style>
  .feature { transition: transform .35s var(--ease-out-expo), box-shadow .35s; }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--shadow-float); }
</style>

<script>
  import { gsap, reduced, onPage } from '../lib/motion';
  onPage(() => {
    if (reduced()) return;
    gsap.utils.toArray<HTMLElement>('[data-pola-float]').forEach((el) => {
      gsap.to(el, { y: -20, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.8 } });
    });
  });
</script>
