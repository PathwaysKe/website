---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Skip the global footer (e.g. 404). */
  bare?: boolean;
}
const { title, description, image, noindex, jsonLd, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en-KE">
  <head>
    <Head {title} {description} {image} {noindex} {jsonLd} />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">Skip to content</a>
    <Preloader />
    <Header />
    <main id="main" class="pt-24 sm:pt-28">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import { onPage, reveals, markers, counters } from '../lib/motion';
      onPage(() => { reveals(); markers(); counters(); });
    </script>
  </body>
</html>
